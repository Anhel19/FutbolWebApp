Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use centrenadorDataDictionary.dd
Use cWebCombo.pkg
Object oEntrenadorZoom is a cWebView
    Set psCaption to "Entrenador"

    Object oEntrenadorDDO is a centrenadorDataDictionary
        Set DDO_Server to Self
    End_Object

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oIdForm is a cWebForm
            Entry_Item entrenador.ID
            Set psCaption to "ID"
            Set piColumnSpan to 3
            Set pbReadOnly to True
        End_Object

        Object oNombreForm is a cWebForm
            Entry_Item entrenador.Nombre
            Set psCaption to "Nombre"
            Set piColumnSpan to 9
        End_Object

        Object oApellidoForm is a cWebForm
            Entry_Item entrenador.Apellido
            Set psCaption to "Apellido"
            Set piColumnSpan to 9
        End_Object

        Object oNacionalidadForm is a cWebCombo
            Entry_Item entrenador.Nacionalidad
            Set psCaption to "Nacionalidad"
            Set piColumnSpan to 6
           Procedure OnFill
        Forward Send OnFill
        Send AddComboItem "Alemán" "Alemán"
        Send AddComboItem "Argentino" "Argentino"
        Send AddComboItem "Belga" "Belga"
        Send AddComboItem "Brasileño" "Brasileño"
        Send AddComboItem "Colombiano" "Colombiano"
        Send AddComboItem "Egipcio" "Egipcio"
        Send AddComboItem "Escocés" "Escocés"
        Send AddComboItem "Esloveno" "Esloveno"
        Send AddComboItem "Español" "Español"
        Send AddComboItem "Francés" "Francés"
        Send AddComboItem "Húngaro" "Húngaro"
        Send AddComboItem "Inglés" "Inglés"
        Send AddComboItem "Italiano" "Italiano"
        Send AddComboItem "Mozambiqueño" "Mozambiqueño"
        Send AddComboItem "Neerlandés" "Neerlandés"
        Send AddComboItem "Noruego" "Noruego"
        Send AddComboItem "Polaco" "Polaco"
        Send AddComboItem "Portugués" "Portugués"
        Send AddComboItem "Uruguayo" "Uruguayo"
    End_Procedure
        End_Object

        Object oEquipoIDForm is a cWebForm
            Entry_Item entrenador.EquipoID
            Set psCaption to "Equipo ID"
            Set piColumnSpan to 4
        End_Object

        Object oEquipoNombreForm is a cWebForm
            Entry_Item equipo.Nombre
            Set psCaption to "Nombre Equipo"
            Set piColumnSpan to 8
            Set pbReadOnly to True
        End_Object

        Object oSaveBtn is a cWebButton
            Set psCaption to "Guardar"
            Set piColumnSpan to 2

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebButton
            Set psCaption to "Eliminar"
            Set piColumnSpan to 2
            Set piColumnIndex to 2

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object
        Object oDespedirBtn is a cWebButton
    Set psCaption to "Despedir"
    Set piColumnSpan to 2
    Set piColumnIndex to 6

    Procedure OnClick
        Move 0 to entrenador.EquipoID
        Send Request_Save
    End_Procedure
End_Object
    End_Object

End_Object
