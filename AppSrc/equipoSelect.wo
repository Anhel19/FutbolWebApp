Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebButton.pkg
Use cequipoDataDictionary.dd

Object oEquipoSelect is a cWebView
    Set psCaption to "Equipos"

    Object oEquipoDDO is a cequipoDataDictionary
        Set DDO_Server to Self
    End_Object

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oNewBtn is a cWebButton
            Set psCaption to "Nuevo"
            Set piColumnSpan to 2

            WebRegisterPath ntNavigateForward oEquipoZoom

            Procedure OnClick
                Send Request_Clear of oEquipoDDO
                Send NavigatePath
            End_Procedure
        End_Object

        Object oEquipoList is a cWebList
            Set pbServerOnRowClick to True
            Set piColumnSpan to 12

            Object oIdCol is a cWebColumn
                Entry_Item equipo.ID
                Set psCaption to "ID"
                Set piWidth to 60
                Set pbSortable to True
            End_Object

            Object oNombreCol is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Nombre"
                Set pbSortable to True
            End_Object

            Object oLigaNombreCol is a cWebColumn
                Entry_Item liga.Nombre
                Set psCaption to "Liga"
                Set pbSortable to True
            End_Object

            WebRegisterPath ntNavigateForward oEquipoZoom

            Procedure OnRowClick String sRowId
                Send NavigatePath
            End_Procedure
        End_Object

    End_Object

End_Object
